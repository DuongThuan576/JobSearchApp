<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Giao diện khi CHƯA đăng nhập -->
        <LinearLayout
            android:id="@+id/layout_guest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/gray_border" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám phá tính năng cá nhân"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToAuth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Đăng nhập / Đăng ký"
                android:layout_marginTop="24dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Giao diện khi ĐÃ đăng nhập -->
        <LinearLayout
            android:id="@+id/layout_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <!-- Profile Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:scaleType="centerCrop"
                    android:background="@color/gray_light"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Họ và tên"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/ivProfileAvatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvProfileProfession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chức danh công việc"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/llContactInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileProfession"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/tvProfileLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Địa điểm"
                        android:textSize="12sp"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:drawablePadding="4dp"
                        android:layout_marginEnd="16dp"/>
                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="12sp"
                        android:drawableStart="@android:drawable/ic_dialog_email"
                        android:drawablePadding="4dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadCV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tải lên CV mới"
                    android:textAllCaps="false"
                    android:layout_marginTop="20dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:layout_constraintTop_toBottomOf="@id/llContactInfo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Danh sách CV -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danh sách CV" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Quản lý" android:textColor="@color/primary" android:textStyle="bold" android:textSize="12sp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/layout_cv_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_search_bar"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_edit" app:tint="#E53935"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/tvCvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chưa có CV" android:textStyle="bold" android:textSize="13sp"/>
                            <TextView android:id="@+id/tvCvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vừa mới cập nhật" android:textSize="11sp" android:textColor="@color/text_sub"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kỹ năng chuyên môn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kỹ năng chuyên môn" android:textStyle="bold" android:textSize="16sp"/>
                        <ImageView
                            android:id="@+id/ivAddSkill"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/ic_menu_add"
                            app:tint="@color/primary"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgProfileSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp">
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa thông tin cá nhân"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="24dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng xuất"
                android:textColor="@color/error"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="start"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>